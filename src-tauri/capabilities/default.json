{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window capability: shell plugin for opening URLs via the OS opener only.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-set-theme",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "shell:allow-open"
  ]
}
