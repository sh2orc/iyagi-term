{
  "compilerOptions": {
    "target": "es2021",
    "lib": ["es2021", "dom", "dom.iterable"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "baseUrl": "../../node_modules/@xterm/xterm/src",
    "paths": { "browser/*": ["browser/*"], "common/*": ["common/*"], "vs/*": ["vs/*"] },
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "useDefineForClassFields": false,
    "experimentalDecorators": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": []
  },
  "include": ["src"]
}
